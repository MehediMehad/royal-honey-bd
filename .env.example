# ==============================================================================
# Royal Honey BD — Production Environment Configuration Template
# ==============================================================================

# Application Environment & Ports
NODE_ENV=production
PORT=5000
CORS_ORIGINS=https://admin.royalhoneybd.com,http://localhost:3000

# PostgreSQL Database (Prisma ORM)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=royal_honey_db
DATABASE_URL="postgresql://postgres:your_secure_postgres_password_here@localhost:5432/royal_honey_db?schema=public"

# Redis (BullMQ & Idempotency Distributed Lock)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Admin Authentication & JWT Security
ADMIN_EMAIL=admin@royalhoneybd.com
ADMIN_PASSWORD=YourSuperSecurePassword123!
JWT_ACCESS_SECRET=your_jwt_access_secret_super_secure_key_min_32_chars
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_super_secure_key_min_32_chars
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# OpenAI API (GPT-4o-mini, Whisper, Text-Embedding-3-small)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Meta Webhook & Security (Facebook Messenger & WhatsApp Cloud API)
META_VERIFY_TOKEN=royal_honey_webhook_verification_token
META_APP_SECRET=your_meta_app_secret_for_hmac_sha256_verification
META_PAGE_ACCESS_TOKEN=your_facebook_page_access_token
WHATSAPP_ACCESS_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# n8n / External Webhook Integration (Optional)
N8N_OUTGOING_WEBHOOK_URL=https://n8n.royalhoneybd.com/webhook/incoming-order

# Steadfast Courier Service API
COURIER_PROVIDER=STEADFAST
STEADFAST_MODE=production
STEADFAST_API_KEY=your_steadfast_api_key_here
STEADFAST_SECRET_KEY=your_steadfast_secret_key_here

# Next.js Frontend Configuration (.env.local in frontend/)
# NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

