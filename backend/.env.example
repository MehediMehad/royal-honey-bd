NODE_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database & Cache
DATABASE_URL="postgresql://royal_honey_user:royal_honey_password@localhost:5432/royal_honey_db?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication & Security
ADMIN_EMAIL=admin@royalhoneybd.com
ADMIN_PASSWORD=AdminPassword123!
JWT_ACCESS_SECRET=royal_honey_jwt_access_secret_super_secure_key_12345
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_SECRET=royal_honey_jwt_refresh_secret_super_secure_key_12345
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# AI & Embedding Model (OpenAI)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Meta Graph API & Webhook (Messenger & WhatsApp)
META_VERIFY_TOKEN=royal_honey_verify_token
META_PAGE_ACCESS_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
N8N_OUTGOING_WEBHOOK_URL=

# Business URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
