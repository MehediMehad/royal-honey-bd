{
  "name": "royal-honey-bd-backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "start": "node ./dist/server.js",
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "prisma:generate": "prisma generate --config ./prisma.config.ts",
    "prisma:migrate": "prisma migrate dev --config ./prisma.config.ts",
    "prisma:push": "prisma db push --config ./prisma.config.ts",
    "prisma:studio": "prisma studio --config ./prisma.config.ts",
    "seed": "tsx prisma/seed.ts",
    "format": "prettier --write ."
  },
  "keywords": [
    "royal-honey-bd",
    "ai-automation",
    "rag",
    "nodejs",
    "typescript",
    "prisma",
    "postgresql"
  ],
  "author": "mehedihasanmehad",
  "license": "ISC",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^8.5.8",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.17.0",
    "prettier": "^3.6.2",
    "prisma": "7.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.2.0",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.79.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "http-status": "^2.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "openai": "^7.15.0",
    "socket.io": "^4.8.1",
    "zod": "^4.0.14"
  }
}
