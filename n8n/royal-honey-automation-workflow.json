        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"01604121107\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"🎉 নতুন কনফার্মড অর্ডার! 🍯\\n\\nঅর্ডার আইডি: \" + $json.body.orderId + \"\\nকাস্টমার: \" + $json.body.customerName + \" (\" + $json.body.customerPhone + \")\\nমোট টাকা: ৳\" + $json.body.totalAmount + \" (\" + $json.body.paymentMethod + \")\\nকুরিয়ার ট্র্যাকিং: \" + ($json.body.courierTrackingId || 'Booked') + \"\\n\\nপণ্য তালিকা:\\n\" + JSON.stringify($json.body.items, null, 2)\n  }\n}"
      },
      "id": "whatsapp-order-confirmed",
      "name": "WhatsApp Alert: Order Confirmed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [750, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v19.0/YOUR_PHONE_NUMBER_ID/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_META_WHATSAPP_ACCESS_TOKEN"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"01604121107\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"⚠️ জরুরি লো-স্টক অ্যালার্ট! 📦\\n\\nপণ্য: \" + $json.body.product.name + \"\\nবর্তমান স্টক: মাত্র \" + $json.body.product.stockCount + \"টি অবশিষ্ট!\\nমিনিমাম লিমিট: \" + $json.body.product.minThreshold + \"টি\\n\\n👉 দ্রুত স্টক রিস্টক করুন: http://localhost:3000/admin/inventory\"\n  }\n}"
      },
      "id": "whatsapp-low-stock",
      "name": "WhatsApp Alert: Low Stock Warning",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [750, 550]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v19.0/YOUR_PHONE_NUMBER_ID/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_META_WHATSAPP_ACCESS_TOKEN"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"01604121107\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"🚨 HUMAN SUPPORT REQUIRED!\\n\\nCustomer: \" + ($json.body.customerName || 'Customer') + \"\\nPhone: \" + ($json.body.customerPhone || 'N/A') + \"\\nChannel: \" + ($json.body.channel || 'Chat') + \"\\n\\nReason: \" + ($json.body.reason || 'Complex inquiry / Complaint') + \"\\n\\n👉 Open & Takeover Chat: http://localhost:3000/admin/inbox\"\n  }\n}"
      },
      "id": "whatsapp-human-handoff",
      "name": "WhatsApp Alert: Human Handoff",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
