        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"channel\": \"WHATSAPP\",\n  \"channelId\": $json.body.entry[0].changes[0].value.messages[0].from,\n  \"content\": $json.body.entry[0].changes[0].value.messages[0].text ? $json.body.entry[0].changes[0].value.messages[0].text.body : \"\",\n  \"mediaUrl\": null,\n  \"mediaType\": \"TEXT\"\n}"
      },
      "id": "forward-to-backend-api",
      "name": "Forward to Royal Honey Backend API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 900]
    }
