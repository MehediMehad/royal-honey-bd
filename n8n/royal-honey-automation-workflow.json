{
  "name": "Royal Honey BD — Complete AI Automation & Sync Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "royal-honey-events",
        "options": {}
      },
      "id": "webhook-royal-honey-events",
      "name": "Royal Honey Events Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.event }}",
                    "rightValue": "GOOGLE_SHEET_BACKUP",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Google Sheet Backup"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.event }}",
                    "rightValue": "ADVANCE_PAYMENT_PENDING",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Payment Pending Alert"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.event }}",
                    "rightValue": "ORDER_CONFIRMED",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Order Confirmed Alert"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.event }}",
                    "rightValue": "LOW_STOCK_ALERT",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Low Stock Alert"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.event }}",
                    "rightValue": "HUMAN_HANDOFF",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Human Handoff Alert"
            }
          ]
        }
      },
      "id": "switch-events",
      "name": "Classify Event",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [440, 300]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_DOCUMENT_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Royal Honey BD Orders",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Order ID": "={{ $json.body.row.orderId }}",
            "Consignment ID": "={{ $json.body.row.consignmentId }}",
            "Tracking Code": "={{ $json.body.row.trackingCode }}",
            "Date Time": "={{ $json.body.row.dateTime }}",
            "Customer Name": "={{ $json.body.row.customerName }}",
            "Phone Number": "={{ $json.body.row.phoneNumber }}",
            "District": "={{ $json.body.row.district }}",
            "Thana": "={{ $json.body.row.thana }}",
            "Delivery Address": "={{ $json.body.row.deliveryAddress }}",
            "Ordered Products": "={{ $json.body.row.orderedProducts }}",
            "Product Total": "={{ $json.body.row.productTotal }}",
            "Delivery Charge": "={{ $json.body.row.deliveryCharge }}",
            "Total Payable": "={{ $json.body.row.totalPayable }}",
            "Payment Method": "={{ $json.body.row.paymentMethod }}",
            "Payment Status": "={{ $json.body.row.paymentStatus }}",
            "Transaction ID": "={{ $json.body.row.transactionId }}",
            "Courier Status": "={{ $json.body.row.courierStatus }}",
            "Order Status": "={{ $json.body.row.orderStatus }}",
            "Source Channel": "={{ $json.body.row.sourceChannel }}"
          },
          "matchingColumns": [
            "Order ID"
          ]
        },
        "options": {}
      },
      "id": "google-sheet-append",
      "name": "Append to Google Sheets (Backup)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [750, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v19.0/YOUR_PHONE_NUMBER_ID/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_META_WHATSAPP_ACCESS_TOKEN"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"01604121107\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"🚨 নতুন অগ্রিম পেমেন্ট ভেরিফিকেশন পেন্ডিং!\\n\\nঅর্ডার আইডি: \" + $json.body.orderId + \"\\nকাস্টমার: \" + $json.body.customerName + \" (\" + $json.body.customerPhone + \")\\nপেমেন্ট মেথড: \" + $json.body.paymentMethod + \"\\nটাকার পরিমাণ: ৳\" + $json.body.amount + \"\\nTrxID: \" + ($json.body.transactionId || 'স্ক্রিনশট পাঠানো হয়েছে') + \"\\n\\n👉 ভেরিফাই করতে ড্যাশবোর্ড দেখুন: \" + ($json.body.takeoverUrl || 'http://localhost:3000/admin/orders')\n  }\n}"
      },
      "id": "whatsapp-payment-pending",
      "name": "WhatsApp Alert: Payment Verification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [750, 250]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v19.0/YOUR_PHONE_NUMBER_ID/messages",
        "authentication": "genericCredentialType",
